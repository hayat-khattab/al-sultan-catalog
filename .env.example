# ==========================================================
# AL SULTAN MEDICAL CATALOG — Environment Variables
# Copy to .env (or set in Netlify UI > Site settings > Environment variables)
# NEVER commit the real .env file with real values.
# ==========================================================

# --- Admin Authentication ---
ADMIN_USERNAME=change_me_admin
ADMIN_PASSWORD=change_me_strong_password

# --- Session (long random string, e.g. `openssl rand -hex 64`) ---
SESSION_SECRET=change_me_to_a_long_random_secret

# --- GitHub (for product storage via API) ---
# Create a PAT: GitHub > Settings > Developer settings > Personal access tokens
# Scopes required: repo (contents:write, commit status)
GITHUB_TOKEN=change_me_github_personal_access_token
GITHUB_OWNER=your_github_username_or_org
GITHUB_REPO=your_repo_name
GITHUB_BRANCH=main
